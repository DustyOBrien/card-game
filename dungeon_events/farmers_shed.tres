[gd_resource type="Resource" script_class="DungeonEvent" format=3]

[ext_resource type="Script" path="res://scripts/dungeon_event.gd" id="2_script"]

[resource]
script = ExtResource("2_script")
event_name = "Farmer's Shed"
area = "Room"
min_tier = 1
text = "The farmer's shed, padlocked tight. You can smell the Hops inside."
picture = ""
choice_labels = PackedStringArray("Use a key", "Use a crowbar", "Kick the door open", "Leave it for now")
chances = Array[int]([100, 50, 25, 100])
effects = PackedStringArray("Use Key; Hops 1", "Use Crowbar; Hops 1", "Hops 1", "Come Back")
fail_effects = PackedStringArray("", "Danger 1; Come Back", "Danger 1; Come Back", "")
results = PackedStringArray("Click! The padlock opens. Inside: a sack of Hops.", "CRACK! The door pops open. Inside: a sack of Hops.", "BANG! The door flies open. Inside: a sack of Hops.", "You leave the shed for now. It'll still be here.")
fail_results = PackedStringArray("", "The crowbar slips with a loud CLANG. The door holds. (Try again, but it's noisy.)", "Ow! The door holds, and that was LOUD. (Try again, or find a key.)", "")
