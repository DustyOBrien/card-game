[resource]
script = ExtResource("1_area")
display_name = "Forest"
description = "A dark, tangled wood. Wolves hunt here, and the Old Oak is waking up. (Coming later: it gets its own map cards once the Farm feels right.)"
unlock_after = "Abandoned Farm"
coming_later = true
material = "Lumber"
sort_order = 1
icon = ExtResource("2_icon")
background = ExtResource("3_background")
map_position = Vector2(640, 380)
rooms = Array[ExtResource("3_ioxcy")]([SubResource("Resource_xifb7"), SubResource("Resource_sne0c"), SubResource("Resource_rqlhb"), SubResource("Resource_mai7g"), SubResource("Resource_ac57c"), SubResource("Resource_x0887"), SubResource("Resource_mbfpi"), SubResource("Resource_dvuvv"), SubResource("Resource_0441h"), SubResource("Resource_1c1y3"), SubResource("Resource_1io8f"), SubResource("Resource_oifte"), SubResource("Resource_nqh0w"), SubResource("Resource_lts0p"), SubResource("Resource_ws05r"), SubResource("Resource_jyjfb"), SubResource("Resource_bavbt"), SubResource("Resource_ht63f"), SubResource("Resource_6hk40"), SubResource("Resource_12kpk"), SubResource("Resource_hidrf"), SubResource("Resource_s5q2c"), SubResource("Resource_tv85o"), SubResource("Resource_i1ps6"), SubResource("Resource_v2l70")])
