theme_override_font_sizes/font_size = 24
text = "Your deck: 0 cards"

[node name="SchoolCountLabel" type="Label" parent="Margin/Layout/Columns/DeckPanel/DeckMargin/DeckBox"]
unique_name_in_owner = true
