[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/spec_select.gd" id="1_spec"]

[node name="SpecSelect" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_spec")

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.12, 0.11, 0.16, 1)

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 32
theme_override_constants/margin_top = 40
theme_override_constants/margin_right = 32
theme_override_constants/margin_bottom = 32

[node name="Layout" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 16

[node name="TitleLabel" type="Label" parent="Margin/Layout"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 40
text = "Choose Your Spec"
horizontal_alignment = 1

[node name="HelpLabel" type="Label" parent="Margin/Layout"]
layout_mode = 2
theme_override_colors/font_color = Color(1, 1, 1, 0.7)
theme_override_font_sizes/font_size = 18
text = "Your spec changes how your class builds decks. You can change it any time outside a run, and your talent points come back when you do."
horizontal_alignment = 1
autowrap_mode = 3

[node name="Center" type="CenterContainer" parent="Margin/Layout"]
layout_mode = 2
size_flags_vertical = 3

[node name="SpecList" type="HBoxContainer" parent="Margin/Layout/Center"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 24

[node name="BottomBar" type="HBoxContainer" parent="Margin/Layout"]
layout_mode = 2

[node name="BackButton" type="Button" parent="Margin/Layout/BottomBar"]
unique_name_in_owner = true
layout_mode = 2
text = "← Change Class"
