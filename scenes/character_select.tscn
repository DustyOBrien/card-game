[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/character_select.gd" id="1_character_select"]

[node name="CharacterSelect" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_character_select")

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.12, 0.11, 0.16, 1)

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 32
theme_override_constants/margin_top = 40
theme_override_constants/margin_right = 32
theme_override_constants/margin_bottom = 40

[node name="Layout" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 16

[node name="TitleLabel" type="Label" parent="Margin/Layout"]
layout_mode = 2
theme_override_font_sizes/font_size = 40
text = "Choose Your Class"
horizontal_alignment = 1

[node name="HelpLabel" type="Label" parent="Margin/Layout"]
layout_mode = 2
theme_override_colors/font_color = Color(1, 1, 1, 0.7)
theme_override_font_sizes/font_size = 18
text = "Your class decides which cards you can put in your deck."
horizontal_alignment = 1

[node name="Center" type="CenterContainer" parent="Margin/Layout"]
layout_mode = 2
size_flags_vertical = 3

[node name="ClassList" type="HBoxContainer" parent="Margin/Layout/Center"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 32
