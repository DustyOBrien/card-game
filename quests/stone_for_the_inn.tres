[ext_resource type="Script" path="res://scripts/quest.gd" id="1_wa867"]

[resource]
script = ExtResource("1_wa867")
quest_name = "Stone for the Inn"
giver = "The King"
text = "\"Well done! Next, an Inn, so adventurers have somewhere to stay. That takes more stone, and the Plains are full of it.\" Press Start Next Run and head to the Plains. No monsters this time, just rocks: the trip shows you how to explore. Bring home 5 Stone and build the Inn."
target = "Inn"
rewards = "Pack Small 2"
next_quest = "Clear the Slimes"
sort_order = 1
