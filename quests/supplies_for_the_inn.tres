[ext_resource type="Script" path="res://scripts/quest.gd" id="2_script"]

[resource]
script = ExtResource("2_script")
quest_name = "Supplies for the Inn"
giver = "Kale"
text = "\"Nobody stops at an Inn with no ale! Go out to the Abandoned Farm and bring me supplies to fix this place up: Stone, Sticks and Wool. And my ale is down in the old Dark Cellar out there. Here, take my key to open it.\" Monsters never come this close to town... but don't push your luck out there. (The Farmer's Sheds have Hops too, if you find their key.)"
objective = "gather"
target = "Have Stone 5; Have Sticks 2; Have Wool 2; Reach Cellar Opened"
amount = 1
start_gift = "Key Item Cellar Key"
rewards = "Gold 10"
next_quest = ""
quest_type = "Story"
starts_after = "Inn Built"
sort_order = 0
seed_cards = ""
area = "Abandoned Farm"
