[gd_resource type="Resource" script_class="Quest" format=3]

[ext_resource type="Script" path="res://scripts/quest.gd" id="1_06hsi"]

[resource]
script = ExtResource("1_06hsi")
quest_name = "Need Hops"
giver = "The Innkeeper"
text = "\"An Inn with no ale is just a house! Hops grow wild in the Plains, but the old farmers locked them away in chests.\" Find small keys on the Plains and open the chests. Bring 3 Hops to the Inn (you hand them over)."
objective = "deliver"
target = "Hops"
amount = 3
rewards = "Pack Small 1; Unlock Adventurer"
starts_after = "Inn Built"
sort_order = 1
