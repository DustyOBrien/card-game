[ext_resource type="Script" path="res://scripts/quest.gd" id="1_06hsi"]

[resource]
script = ExtResource("1_06hsi")
quest_name = "Need Hops"
giver = "The Innkeeper"
text = "\"An Inn with no ale is just a house! The old farmers grew Hops, and locked them away in their sheds.\" Find small keys on the Abandoned Farm and open the Locked Sheds. Bring 3 Hops to the Inn (you hand them over)."
objective = "deliver"
target = "Hops"
amount = 3
rewards = "Pack Small 1"
next_quest = "Clear the Slimes"
starts_after = "Adventurer Trained"
sort_order = 1
area = "Abandoned Farm"
